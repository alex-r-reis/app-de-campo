# .env.example
# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.
# Variáveis Vite só ficam acessíveis ao código do navegador se começarem com VITE_.

# Nome exibido no app
VITE_APP_NAME="ATER Cacau Campo"

# Variante do deploy: cacau_i ou cacau_ii
VITE_APP_VARIANT=cacau_i

# URL do backend (pasta server/) que sincroniza com o Google Drive e o Google Sheets.
# Em desenvolvimento local, o backend roda em http://localhost:3001 por padrão.
VITE_API_BASE_URL=http://localhost:3001
