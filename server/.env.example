# server/.env.example
# Copie para server/.env e preencha com as credenciais reais.
# Passo a passo completo de como obter cada valor: ver README.md (seção
# "Configurando a integração com Google Drive e Sheets").

PORT=3001

# Variante do deploy: cacau_i ou cacau_ii
APP_VARIANT=cacau_i

# --- Conta de serviço do Google Cloud ---
# E-mail da conta de serviço (termina em ...iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chave privada da conta de serviço, copiada do arquivo JSON baixado no
# Google Cloud Console. Mantenha as quebras de linha como "\n" literais
# (é assim que o arquivo JSON já vem), entre aspas duplas:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExemploExemploExemplo\n-----END PRIVATE KEY-----\n"

# --- Google Drive ---
# ID da pasta raiz onde as subpastas de cada visita serão criadas.
# É o trecho final da URL da pasta: https://drive.google.com/drive/folders/ESTE_TRECHO
GOOGLE_DRIVE_FOLDER_ID=

# --- Google Sheets ---
# ID da planilha (trecho da URL): https://docs.google.com/spreadsheets/d/ESTE_TRECHO/edit
GOOGLE_SHEET_ID=

# Nome da aba dentro da planilha onde as linhas serão adicionadas
GOOGLE_SHEET_TAB_NAME=Visitas

# --- OAuth de usuario Google (recomendado para pastas em "Meu Drive") ---
# Service Accounts nao possuem cota de armazenamento em "Meu Drive".
# Configure estes 3 valores para criar arquivos usando a cota da conta Google dona
# das pastas/planilhas. Quando preenchidos, eles substituem a Service Account.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Painel de administração ---
# Token simples exigido no painel/admin para listar as visitas.
# Deixe em branco para uso só em rede local/confiável (sem senha).
ADMIN_TOKEN=
